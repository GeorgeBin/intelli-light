Package: intelli-light
Version: @VERSION@
Section: utils
Priority: optional
Architecture: @ARCH@
Maintainer: GeorgeBin contributors <noreply@github.com>
Depends: libc6 (>= 2.38), libgcc-s1, libstdc++6 (>= 14), libqt6core6t64 (>= 6.8.2), libqt6gui6 (>= 6.8.2), libqt6network6 (>= 6.8.2), libqt6widgets6 (>= 6.8.2), libkf6coreaddons6 (>= 6.13.0), libkf6i18n6 (>= 6.13.0), libkf6statusnotifieritem6 (>= 6.13.0), nodejs, systemd
