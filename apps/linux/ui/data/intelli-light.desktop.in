[Desktop Entry]
Type=Application
X-AppId=@INTELLI_LIGHT_APP_ID@
Name=Intelli Light
GenericName=Agent Status Monitor
Comment=Native KDE desktop for agent status and GeorgeLight configuration
Exec=intelli-light-desktop
Icon=intelli-light
Terminal=false
Categories=Development;Utility;
StartupNotify=true
X-KDE-StartupNotify=true
