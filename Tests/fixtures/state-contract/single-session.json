      "sessions": [{"provider": "codex", "state": "waitingApproval", "sessionId": "approval", "ts": 10000, "ownerPid": 101, "ownerKind": "session"}],
      "expected": {"agentState": "waitingApproval", "lightState": "actionRequired", "displaySession": "codex:approval"}
    },
